# From process start through the startup settings form to the main menu.
# Blocked: host mouse routing still targets the hidden VCL utility window.
# Coordinates are guest pixels read from the 1024x768 startup-form dump.
# dump writes smoke_<name>_present.ppm in the dump directory.
#   RECOMP_SCRIPT=$PWD/smoke/main-menu.script RECOMP_HOST_DUMP_DIR=$PWD/build/smoke \
#   RECOMP_PROFILE_DIR=$PWD/build/task14-profile \
#   RECOMP_DDRAW_MODES=800x600x16,800x600x32 RECOMP_SMOKE_DRAWABLE=800x600 build/recomp/pop_smoke
wait 6000
dump startup-form
click left 578 493
wait 6000
dump main-menu
wait 1000
